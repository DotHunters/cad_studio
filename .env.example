# Copy to .env.local and fill in. Never commit real values (AGENTS.md §11).

# --- Database (managed Postgres, Canada region) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cad_studio"

# --- Auth (admin only) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional: falls back to RESEND_API_KEY. Without either, sign-in links are printed to
# the server log (development only).
AUTH_RESEND_KEY=
# First admin account, created by `pnpm db:seed` (owner's email; more staff are added in admin).
SEED_ADMIN_EMAIL=

# --- Email ---
RESEND_API_KEY=
# Dummy domain until the owner provides one (Q6)
EMAIL_FROM="Cad Studio <bookings@cadstudio.example>"
ADMIN_NOTIFY_EMAIL=

# --- Images ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Spam protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis) ---
# Without these, public forms are not rate limited (fine locally; logged as an error in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Signed links (reschedule/cancel/review) and cron ---
# Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=
CRON_SECRET=

# --- Payments (phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STUDIO_TIMEZONE="America/Toronto"
# Sample clients/reviews are visible only when true. Must be false in production.
SHOW_SAMPLE_CONTENT=true
# Shows the "Pricing pending owner confirmation" banner until true.
PRICING_CONFIRMED=false
# Privacy/Terms show a "draft — pending legal review" notice until true.
LEGAL_REVIEWED=false
