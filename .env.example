# Copy to .env.local and fill in. Never commit real values (AGENTS.md §11).

# --- Database (managed Postgres, Canada region) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cad_studio"

# --- Auth (admin only) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Super admin: always able to sign in, can't be changed or removed in the admin. Creates
# the other users (Admin → Team). Password: at least 12 characters, e.g. openssl rand -base64 24.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Email ---
RESEND_API_KEY=
# Dummy domain until the owner provides one (Q6)
EMAIL_FROM="CAD Studio Photography <bookings@cadstudio.example>"
ADMIN_NOTIFY_EMAIL=

# --- Images ---
# Admin photo uploads (portfolio). Added automatically when a Vercel Blob store is connected
# to the Vercel project; copy it here (vercel env pull) to upload from local development.
BLOB_READ_WRITE_TOKEN=
# Cloudinary (optional, older plan): only needed for images whose id is a Cloudinary id.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Spam protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis) ---
# Without these, public forms are not rate limited (fine locally; logged as an error in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Signed links (reschedule/cancel/review) and cron ---
# Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=
CRON_SECRET=

# --- Payments (phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STUDIO_TIMEZONE="America/Toronto"
# Sample clients/reviews are visible only when true. Must be false in production.
SHOW_SAMPLE_CONTENT=true
# Shows the "Pricing pending owner confirmation" banner until true.
PRICING_CONFIRMED=false
# Privacy/Terms show a "draft — pending legal review" notice until true.
LEGAL_REVIEWED=false
