// CAD Studio Photography data model — AGENTS.md §7.
// Money: integer CAD cents. Times: UTC. Translatable text: `*Fr` companion columns
// (nullable, fall back to English). Auth.js tables arrive with task 7.1.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  CORPORATE
  WEDDING
  FAMILY
  GATHERING
  PROFESSIONAL
  PRODUCT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  /// Withdrawn by the studio; can no longer be booked.
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewType {
  CUSTOMER
  RECOMMENDATION
}

enum Reach {
  LOCAL
  GLOBAL
}

enum Role {
  ADMIN
  STAFF
}

/// PAYMENT_LINK = external link sent by admin; STRIPE = phase 2.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  PAYMENT_LINK
  STRIPE
}

enum ChangeRequestType {
  RESCHEDULE
  CANCEL
}

enum ChangeRequestStatus {
  OPEN
  RESOLVED
}

enum AddOnUnit {
  FLAT
  PER_HOUR
  PER_ITEM
}

enum Locale {
  en
  fr
}

model Package {
  id               String        @id @default(cuid())
  slug             String        @unique
  category         Category
  name             String
  nameFr           String?
  summary          String
  summaryFr        String?
  /// Markdown.
  description      String
  descriptionFr    String?
  basePriceCents   Int
  includedHours    Int
  includedShooters Int           @default(1)
  editedImages     Int?
  turnaroundDays   Int?
  inclusions       String[]
  inclusionsFr     String[]
  exclusions       String[]
  exclusionsFr     String[]
  /// [{ q, a, qFr?, aFr? }]
  faqs             Json          @default("[]")
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  images           Image[]
  addOns           AddOn[]
  /// Optional options such as Silver / Gold / Platinum. When present, they set the price,
  /// hours and photographers, and the package's own values are only defaults.
  tiers            PackageTier[]
  quotes           Quote[]
  bookings         Booking[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([category, isActive, sortOrder])
}

/// One option of a package (e.g. Gold). Quotes and bookings keep the tier they were priced
/// from in their breakdown (`packageSlug` = "<package slug>:<tier key>"), so the key never
/// changes once created.
model PackageTier {
  id               String   @id @default(cuid())
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  key              String
  name             String
  nameFr           String?
  basePriceCents   Int
  includedHours    Int
  includedShooters Int      @default(1)
  editedImages     Int?
  turnaroundDays   Int?
  inclusions       String[]
  inclusionsFr     String[]
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([packageId, key])
  @@index([packageId, sortOrder])
}

model AddOn {
  id         String     @id @default(cuid())
  /// e.g. VIDEO, DRONE, ALBUM, RUSH
  code       String     @unique
  name       String
  nameFr     String?
  priceCents Int
  unit       AddOnUnit
  categories Category[]
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  packages   Package[]
}

/// Admin-editable knobs for the quote engine, e.g. EXTRA_HOUR_RATE.
model PricingRule {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Admin-editable content/config, e.g. CANCELLATION_POLICY, PAYMENT_INSTRUCTIONS.
/// Localized text is stored as { en, fr }.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model TaxRate {
  /// ON, BC, QC, … or INTL
  province String  @id
  gst      Decimal @db.Decimal(6, 5)
  pst      Decimal @db.Decimal(6, 5)
  hst      Decimal @db.Decimal(6, 5)
  label    String
}

/// Yearly sequences for references like CAD-Q-2026-0001. key = "Q-2026" | "B-2026".
model ReferenceCounter {
  key   String @id
  value Int    @default(0)
}

model Customer {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?
  locale             Locale    @default(en)
  marketingOptIn     Boolean   @default(false)
  /// When terms/privacy consent was given.
  consentAt          DateTime?
  /// When marketing opt-in was given (CASL).
  marketingConsentAt DateTime?
  quotes             Quote[]
  bookings           Booking[]
  createdAt          DateTime  @default(now())
}

model Quote {
  id              String      @id @default(cuid())
  reference       String      @unique
  category        Category
  packageId       String?
  package         Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  eventDate       DateTime
  durationHours   Decimal     @db.Decimal(5, 2)
  photographers   Int
  guestCount      Int?
  province        String
  city            String?
  distanceKm      Int?
  isInternational Boolean     @default(false)
  /// [{ code, qty }]
  addOns          Json
  /// Line items as computed by the quote engine.
  breakdown       Json
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  status          QuoteStatus @default(SENT)
  expiresAt       DateTime
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  booking         Booking?
  createdAt       DateTime    @default(now())

  @@index([status, createdAt])
}

model Booking {
  id                 String                 @id @default(cuid())
  reference          String                 @unique
  category           Category
  packageId          String?
  package            Package?               @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quoteId            String?                @unique
  quote              Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// UTC
  startAt            DateTime
  /// UTC
  endAt              DateTime
  photographers      Int
  guestCount         Int?
  venue              String?
  notes              String?
  status             BookingStatus          @default(PENDING)
  /// Agreed price at booking time (quoted price if booked from a matching quote).
  subtotalCents      Int?
  taxCents           Int?
  totalCents         Int?
  /// Line items, tax lines and flags as priced at booking time.
  breakdown          Json?
  depositCents       Int?
  paymentMethod      PaymentMethod?
  /// Admin sent the payment request email.
  paymentRequestedAt DateTime?
  /// Optional link included in that email.
  paymentLinkUrl     String?
  /// Set by admin when payment is received.
  depositPaidAt      DateTime?
  customerId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  reviews            Review[]
  changeRequests     BookingChangeRequest[]
  /// Photographers/staff assigned to cover the event (admin, 7.6f).
  assignees          User[]                 @relation("BookingAssignees")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([startAt])
  @@index([status, startAt])
}

model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  reason String?
}

model PortfolioProject {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  titleFr          String?
  /// null => "Private client". Shown only when consentToPublish is true.
  clientName       String?
  consentToPublish Boolean   @default(false)
  category         Category
  reach            Reach
  city             String?
  country          String
  /// null until the owner confirms it (photos without EXIF dates).
  year             Int?
  /// Markdown.
  story            String
  storyFr          String?
  coverId          String?
  images           Image[]
  featured         Boolean   @default(false)
  isSample         Boolean   @default(false)
  publishedAt      DateTime?

  @@index([category, reach, year])
}

model Image {
  id               String            @id @default(cuid())
  /// Cloudinary public id.
  publicId         String            @unique
  width            Int
  height           Int
  /// Tiny base64 preview for next/image placeholder="blur"; generated at upload (7.4).
  blurDataUrl      String?
  /// Required, descriptive.
  alt              String
  altFr            String?
  category         Category?
  tags             String[]
  inGallery        Boolean           @default(true)
  sortOrder        Int               @default(0)
  /// Admin confirmed client consent to publish (AGENTS.md §9).
  consentToPublish Boolean           @default(false)
  isSample         Boolean           @default(false)
  projectId        String?
  project          PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  packageId        String?
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([inGallery, category, sortOrder])
}

model Review {
  id               String       @id @default(cuid())
  type             ReviewType
  authorName       String
  /// Recommendations only.
  authorTitle      String?
  /// Recommendations only.
  company          String?
  /// Cloudinary id of the company logo; shown only when logoPermission is true.
  logoPublicId     String?
  logoPermission   Boolean      @default(false)
  /// 1–5, required for CUSTOMER (enforced in validation).
  rating           Int?
  category         Category?
  body             String
  locale           Locale       @default(en)
  verified         Boolean      @default(false)
  bookingId        String?
  booking          Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status           ReviewStatus @default(PENDING)
  /// Set by automatic spam/profanity check; stays PENDING for manual review.
  flagged          Boolean      @default(false)
  featured         Boolean      @default(false)
  consentToPublish Boolean
  isSample         Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([status, type, createdAt])
}

/// Client request (via the signed booking link) to reschedule or cancel. Handled by the studio
/// in admin; nothing changes automatically (cancellation policy is owner-defined).
model BookingChangeRequest {
  id            String              @id @default(cuid())
  bookingId     String
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          ChangeRequestType
  /// Studio-local "YYYY-MM-DD" the client would prefer (reschedules).
  preferredDate String?
  message       String?
  status        ChangeRequestStatus @default(OPEN)
  createdAt     DateTime            @default(now())

  @@index([bookingId, status])
}

// --- Admin auth (Auth.js v5, Prisma adapter; AGENTS.md §2, §11) ---

/// Admin/staff account. Sign-in is by email + password and only for existing, active users —
/// nobody can sign themselves up.
model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  role               Role      @default(STAFF)
  isActive           Boolean   @default(true)
  /// scrypt hash (src/lib/auth/password.ts). Null for the super admin, whose password is in .env.
  passwordHash       String?
  /// Set when an admin chooses the password; the user must pick their own at next sign-in.
  mustChangePassword Boolean   @default(false)
  accounts           Account[]
  sessions           Session[]
  assignedBookings   Booking[] @relation("BookingAssignees")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Who changed what in admin (AGENTS.md §6.10). Append-only; the email is a snapshot so
/// entries stay readable after an account is removed.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String?
  userEmail  String
  /// e.g. "package.update", "booking.cancel", "review.approve"
  action     String
  entityType String
  entityId   String?
  /// One readable line, e.g. "Wedding: price $2,800.00 → $3,000.00".
  summary    String
  details    Json?

  @@index([createdAt])
  @@index([entityType, entityId])
}
